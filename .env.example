# ─── Supabase ────────────────────────────────────────────
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  
# ⚠️  Service Role Key — nunca exponha no frontend!

# ─── JWT (para tokens da aplicação) ─────────────────────
JWT_SECRET=gere-uma-chave-secreta-aqui-com-64-chars-minimo

# ─── Frontend (Vite — prefixo VITE_) ────────────────────
VITE_API_URL=
# Deixe vazio para produção (mesma origin no Vercel).
# Em dev local: VITE_API_URL=http://localhost:3000

# ─── Supabase Realtime (Frontend) ───────────────────────
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# ⚠️  Use apenas a chave anon/pública — segura para exposição no browser.
# Essas variáveis habilitam atualização em tempo real do Kanban.
